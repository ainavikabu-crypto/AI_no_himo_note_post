    {
      "parameters": {
        "jsCode": "// キーワード文字列をカンマで分割して配列に変換\nconst keywordsString = $json.keywords || \"\";\n\n// カンマで分割して配列にする\nconst keywordsArray = keywordsString.split(',').map(keyword => keyword.trim());\n\n// 各キーワードを個別のアイテムとして返す\nreturn keywordsArray.map(keyword => ({\n  keyword: keyword,\n  index: keywordsArray.indexOf(keyword) + 1,\n  total: keywordsArray.length\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
