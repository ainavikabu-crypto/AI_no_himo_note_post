      "name": "Split In Batches"
    },
    {
      "parameters": {
        "jsCode": "// 各キーワードを処理\nconst keyword = $json.keyword;\nconst index = $json.index;\nconst total = $json.total;\n\n// 処理結果を返す\nreturn {\n  processedKeyword: keyword,\n  keywordNumber: index,\n  totalKeywords: total,\n  message: `キーワード ${index}/${total}: ${keyword}`,\n  timestamp: new Date().toISOString()\n};"
      },
