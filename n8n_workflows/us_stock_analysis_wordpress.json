              "responseFormat": "file"
            }
          }
        }
      },
      "id": "download-image",
      "name": "アイキャッチ画像をダウンロード",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 400]
    },
    {
      "parameters": {
        "resource": "media",
        "operation": "upload",
        "additionalFields": {
          "title": "={{ $node['WordPress投稿準備'].json.ticker }}-analysis-eyecatch",
          "alt_text": "={{ $node['WordPress投稿準備'].json.companyName }} 銘柄分析アイキャッチ"
        }
      },
      "id": "wordpress-upload-media",
      "name": "WordPress - 画像アップロード",
      "type": "n8n-nodes-base.wordpress",
      "typeVersion": 1,
      "position": [1540, 400],
      "credentials": {
        "wordpressApi": {
          "id": "your-wordpress-credential-id",
          "name": "WordPress API"
        }
      }
    },
    {
      "parameters": {
        "resource": "post",
        "operation": "create",
        "title": "=【銘柄分析】{{ $node['WordPress投稿準備'].json.companyName }}（{{ $node['WordPress投稿準備'].json.ticker }}）",
        "content": "={{ $node['WordPress投稿準備'].json.articleContent }}",
        "additionalFields": {
          "status": "draft",
          "featured_media": "={{ $node['WordPress - 画像アップロード'].json.id }}",
          "categories": ["米国株", "AI銘柄", "銘柄分析"],
          "tags": ["{{ $node['WordPress投稿準備'].json.ticker }}", "米国株", "AI", "小型株", "投資"]
        }
      },
      "id": "wordpress-create-post",
      "name": "WordPress - 記事投稿",
      "type": "n8n-nodes-base.wordpress",
      "typeVersion": 1,
      "position": [1760, 400],
      "credentials": {
        "wordpressApi": {
          "id": "your-wordpress-credential-id",
          "name": "WordPress API"
        }
      },
      "notesInFlow": true,
      "notes": "下書きとしてWordPressに投稿"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "success"
            },
            {
              "name": "postId",
              "value": "={{ $json.id }}"
            },
            {
              "name": "postUrl",
              "value": "={{ $json.link }}"
            },
            {
              "name": "message",
              "value": "=記事「{{ $node['WordPress投稿準備'].json.companyName }}（{{ $node['WordPress投稿準備'].json.ticker }}）」の銘柄分析が完了しました。"
            }
          ]
        },
        "options": {}
      },
      "id": "output-result",
      "name": "完了通知",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [1980, 400]
    }
