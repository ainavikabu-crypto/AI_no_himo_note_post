      "name": "Split In Batches"
    },
    {
      "parameters": {
        "jsCode": "// 各アイテムを処理\nconst value = $json.value;\nconst index = $json.index;\nconst total = $json.total;\n\n// 処理結果を返す\nreturn {\n  json: {\n    item: value,\n    position: index,\n    totalItems: total,\n    message: `アイテム ${index}/${total}: ${value}`,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
