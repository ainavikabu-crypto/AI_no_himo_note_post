      "parameters": {
        "jsCode": "// カンマ区切りの文字列を分割\nconst text = $json.text || \"\";\n\n// カンマで分割して配列にする\nconst items = text.split(',').map(item => item.trim());\n\n// 各アイテムを個別のオブジェクトとして返す\nreturn items.map((item, index) => ({\n  json: {\n    value: item,\n    index: index + 1,\n    total: items.length\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
