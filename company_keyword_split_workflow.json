      "name": "Split In Batches"
    },
    {
      "parameters": {
        "jsCode": "// 各キーワードを処理\nconst companyName = $json.companyName;\nconst keyword = $json.keyword;\nconst searchQuery = $json.searchQuery;\nconst index = $json.index;\nconst total = $json.total;\n\n// 処理結果を返す\nreturn {\n  json: {\n    companyName: companyName,\n    keywordType: keyword,\n    fullSearchQuery: searchQuery,\n    itemNumber: index,\n    totalItems: total,\n    message: `検索キーワード ${index}/${total}: ${searchQuery}`,\n    timestamp: new Date().toISOString(),\n    // 次のノードで使用可能なデータ\n    readyForSearch: true\n  }\n};"
      },
