    {
      "parameters": {
        "jsCode": "// 企業名を取得\nconst companyName = $json.companyName || \"\";\n\n// 検索キーワードのサフィックスを定義\nconst keywords = [\n  \"overview\",\n  \"Business description\",\n  \"financial result\"\n];\n\n// 企業名 + キーワードの組み合わせを生成\nconst searchKeywords = keywords.map((keyword, index) => ({\n  json: {\n    companyName: companyName,\n    keyword: keyword,\n    searchQuery: `${companyName} ${keyword}`,\n    index: index + 1,\n    total: keywords.length\n  }\n}));\n\n// 配列を返す\nreturn searchKeywords;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
